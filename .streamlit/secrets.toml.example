# Exemple de configuration Streamlit Secrets pour Turso et Cloudinary
# Copiez ce contenu dans .streamlit/secrets.toml en local ou dans les "Secrets" de Streamlit Cloud

# Base de données Turso (optionnel, sinon SQLite local)
TURSO_DATABASE_URL = "libsql://votre-base-nom.turso.io"
TURSO_AUTH_TOKEN = "votre_token_jwt_turso"

# Stockage Cloudinary (requis pour le Coffre-fort Numérique / GED)
# Disponible sur : https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME = "votre_cloud_name"
CLOUDINARY_API_KEY = "votre_api_key"
CLOUDINARY_API_SECRET = "votre_api_secret"
